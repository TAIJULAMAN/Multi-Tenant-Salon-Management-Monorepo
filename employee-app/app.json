{
  "expo": {
    "name": "employee-app",
    "slug": "employee-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/appIcon.png",
    "scheme": "employeeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app/appIcon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#635BFF",
        "foregroundImage": "./assets/app/appIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mohammadalasad.employeeapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#635BFF",
          "image": "./assets/app/appIcon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
